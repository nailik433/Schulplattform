# Copy this file to `.env` and fill in real values on your server.
# These variables are read by config/settings.py.

# --- Core ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false

# Comma-separated list of the domains/IPs the site is served under.
DJANGO_ALLOWED_HOSTS=schulplattform.example.de,www.schulplattform.example.de

# Needed behind HTTPS on a real domain (include the scheme).
DJANGO_CSRF_TRUSTED_ORIGINS=https://schulplattform.example.de

# --- Database (PostgreSQL in production) ---
# If DJANGO_DB_NAME is unset, the app falls back to a local SQLite file.
DJANGO_DB_ENGINE=django.db.backends.postgresql
DJANGO_DB_NAME=schulplattform
DJANGO_DB_USER=schulplattform
DJANGO_DB_PASSWORD=change-me
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=5432

# --- HTTPS hardening (only used when DJANGO_DEBUG=false) ---
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=2592000

# --- Deployment with docker compose (Caddy handles HTTPS automatically) ---
# Your domain, its DNS A-record must point at the server's IP.
DOMAIN=schulplattform.example.de
# Address Let's Encrypt uses for certificate notifications.
LETSENCRYPT_EMAIL=admin@example.de
